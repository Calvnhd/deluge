# Copy this file to .env and adjust paths for your machine

# Absolute path to the root of the Deluge backup directory in this repository
DELUGE_ROOT="/home/you/source/deluge/DELUGE"

# Mount point of the Deluge SD card
SD_CARD_PATH="/media/$USER/DELUGE"

# Absolute path to the local folder used for cloud backup of SAMPLES/
CLOUD_BACKUP_PATH="C:/Users/you/OneDrive/DelugeBackup/SAMPLES"

# Source directory to archive (SD_CARD_PATH or DELUGE_ROOT)
ZIP_SOURCE_PATH=${SD_CARD_PATH}

# Destination directory for .zip backup archives
ZIP_DEST_PATH="C:/Users/you/OneDrive/DelugeBackup"